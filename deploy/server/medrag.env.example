# /opt/medrag/medrag.env on the server (mode 600, owned by the service user). Systemd EnvironmentFile and compose --env-file.
# Keys are added by the owner on the server; never copied from the laptop or committed.
MEDRAG_ENV=demo
MEDRAG_LOG_LEVEL=INFO
MEDRAG_LOG_QUERY_TEXT=false
MEDRAG_OPENSEARCH_URL=http://127.0.0.1:9201
MEDRAG_REDIS_URL=redis://127.0.0.1:6380/0
MEDRAG_CLICKHOUSE_HOST=127.0.0.1
MEDRAG_CLICKHOUSE_PORT=8124
MEDRAG_CLICKHOUSE_USER=medrag
MEDRAG_CLICKHOUSE_PASSWORD=<generated on the server>
MEDRAG_CHAT_RETENTION_DAYS=90
MEDRAG_LLM_MODEL=claude-sonnet-5-5
MEDRAG_LLM_EFFORT=medium
MEDRAG_RETRIEVAL_PLAN=v12_t3
MEDRAG_ALIAS_TABLE_PATH=/opt/medrag/app/data/processed/medicine/aliases_4f82ace9eb635732.json
MEDRAG_ANSWER_PROMPT=v4.1
ANTHROPIC_API_KEY=
# Tracing (ADR-008): set MEDRAG_TRACING=langfuse plus the three LANGFUSE_* values to send metadata-only traces.
MEDRAG_TRACING=none
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
MEDRAG_TRACE_CONTENT=false
