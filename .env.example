# Copy to .env for local development. Never commit .env.
# All settings use the MEDRAG_ prefix and are validated at startup (src/medical_rag/core/config.py).

MEDRAG_ENV=local
MEDRAG_LOG_LEVEL=INFO
# Full query/answer text is NOT logged unless this is true (synthetic demo inputs only).
MEDRAG_LOG_QUERY_TEXT=false

# Local development OpenSearch from docker-compose.yml (security plugin disabled, local only).
MEDRAG_OPENSEARCH_URL=http://127.0.0.1:9200
MEDRAG_OPENSEARCH_TIMEOUT_S=10

# Data locations (kept out of Git).
MEDRAG_DATA_DIR=data

# Claude API for grounded answers and the Ragas judge (ADR-016 demo default). Your own key; never commit .env.
ANTHROPIC_API_KEY=
MEDRAG_LLM_MODEL=claude-sonnet-5-5
MEDRAG_LLM_EFFORT=medium
# Ragas judge (kept separate from the generator to limit self-grading).
# Ragas sends no usage telemetry.
RAGAS_DO_NOT_TRACK=true

# Optional, used by Phase 1 discovery scripts only.
# OPENFDA_API_KEY=
# MEDRAG_NCBI_EMAIL=you@example.org   # contact email NCBI E-utilities asks for (your own)

# Chat sessions (local dev only): Redis short-term memory, ClickHouse history.
MEDRAG_REDIS_URL=redis://127.0.0.1:6379/0
MEDRAG_CLICKHOUSE_HOST=127.0.0.1
MEDRAG_CLICKHOUSE_PORT=8123
MEDRAG_CLICKHOUSE_USER=medrag
MEDRAG_CLICKHOUSE_PASSWORD=
MEDRAG_CHAT_RETENTION_DAYS=90

# Ragas judge: Kimi K3 on Fireworks AI (OpenAI-compatible). Your own key; only in .env, never in .env.example.
MEDRAG_JUDGE_PROVIDER=fireworks
MEDRAG_JUDGE_MODEL=accounts/fireworks/models/kimi-k3
MEDRAG_JUDGE_REASONING_EFFORT=low
FIREWORKS_API_KEY=

# Retrieval v1.2 plan for hybrid search (API and chat): none = plain hybrid baseline; v12_t3 = medicine/source/
# section-aware plan (experimental, selected on the v2.0 dev split). Alias table defaults to the newest
# data/processed/medicine/aliases_*.json (build it with scripts/phase5/build_medicine_aliases.py).
MEDRAG_RETRIEVAL_PLAN=none

# Answer prompt version: v4.1 (default), or v4, v3, v2, v1 (earlier versions, for comparison).
MEDRAG_ANSWER_PROMPT=v4.1
MEDRAG_ALIAS_TABLE_PATH=

# Tracing (ADR-008): none (default) or langfuse. LANGFUSE_HOST picks the instance: https://cloud.langfuse.com (EU),
# https://us.cloud.langfuse.com (US), or a self-hosted URL such as http://127.0.0.1:3000 (deploy/langfuse/).
# Traces hold metadata only; MEDRAG_TRACE_CONTENT=true also sends question/answer/passage text (synthetic demo
# inputs only, CLAUDE.md rule 9). Keys are your own and stay in .env.
MEDRAG_TRACING=none
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
MEDRAG_TRACE_CONTENT=false
MEDRAG_TRACE_SAMPLE_RATE=1.0
